{
  "name": "daien-english-exam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "岱恩英语机测练习系统（非官方）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "bank:build": "node scripts/build-bank.mjs",
    "bank:validate": "node scripts/validate-bank.mjs",
    "bank:stats": "node scripts/stats.mjs",
    "check": "npm run typecheck && npm run test && npm run bank:validate"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
